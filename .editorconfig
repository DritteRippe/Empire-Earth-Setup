# https://editorconfig.org - see also .gitattributes for the line endings stored in git.
root = true

# Own Inno Setup scripts (top level and ci/tests; third-party code under internal/ keeps its format).
# UTF-8 *with* BOM is required: Inno Setup 6.2 reads BOM-less files with the ANSI code page,
# which breaks non-ASCII text (translations, accented folder names, credits).
[{/*.iss,/ci/tests/*.iss}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 2

# dgVoodoo configurations: ASCII, CRLF, a line end at the end, tabs kept (ADR 0005)
[config/dgVoodoo/*.conf]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = false
indent_style = unset
